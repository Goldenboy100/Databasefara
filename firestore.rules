rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.matches('.*admin.*') ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.matches('.*developer.*')
      );
    }

    function isEditor() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.matches('.*editor.*') ||
        isAdmin()
      );
    }

    // --- Collections ---

    // Users: Owners can read/write their own profiles, admins can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
    }

    // Rates: Everyone can read, editors/admins can write
    match /rates/{rateId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Headlines: Everyone can read, editors/admins can write
    match /headlines/{headlineId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Ads: Everyone can read, editors/admins can write
    match /ads/{adId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Config: Everyone can read, admins can write
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Accounting: Owner isolated
    match /accounting_clients/{clientId} {
      allow read, write: if isOwner(resource.data.userId) || (request.resource != null && isOwner(request.resource.data.userId));
    }

    match /accounting_transactions/{txId} {
      allow read, write: if isOwner(resource.data.userId) || (request.resource != null && isOwner(request.resource.data.userId));
    }

    match /accounting_balances/{balanceId} {
      allow read, write: if isOwner(resource.data.userId) || (request.resource != null && isOwner(request.resource.data.userId));
    }
  }
}
